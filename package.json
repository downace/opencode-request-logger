{
  "name": "opencode-request-logger",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenCode plugin that logs raw LLM request bodies to disk",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.32"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.32",
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3"
  }
}
